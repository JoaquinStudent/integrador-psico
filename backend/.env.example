# Runtime: transaction pooler (6543). Alembic usa el directo (5432).
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_ECHO=false

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=session-files

OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5

# Para usar la tablet del paciente hace falta agregar aqui el origen de la IP de red,
# porque el navegador de la tablet carga la app desde ahi y el preflight se rechaza sin
# esto. La IP cambia al cambiar de red: mirala con `ipconfig getifaddr en0` (macOS) o en
# la linea "Network:" que imprime `npm run dev`, y arranca el backend con --host 0.0.0.0.
#   CORS_ORIGINS=["http://localhost:5173","http://192.168.1.50:5173"]
CORS_ORIGINS=["http://localhost:5173"]
