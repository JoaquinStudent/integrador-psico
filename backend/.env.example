# Runtime: transaction pooler (6543). Alembic usa el directo (5432).
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DB_ECHO=false

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=session-files

OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5

# Todo origen desde el que se carga el frontend tiene que estar aqui, o el navegador
# bloquea TODAS las llamadas a la API y la app se ve viva pero no hace nada.
#
# Dos trampas que ya nos costaron un rato:
#
#  1. **El puerto.** Si el 5173 esta ocupado, Vite arranca en 5174 sin avisar mas que
#     una linea en la consola, y ese origen distinto queda bloqueado. Por eso van
#     listados 5173, 5174 y 5175.
#  2. **La IP de red.** Para usar la tablet del paciente hace falta el origen de la IP
#     LAN, porque la tablet carga la app desde ahi. Cambia al cambiar de red: mirala con
#     `ipconfig getifaddr en0` (macOS) o en la linea "Network:" de `npm run dev`, y
#     arranca el backend con --host 0.0.0.0.
#
# Ojo: esto se lee una sola vez al arrancar. Tocar el .env no basta, hay que reiniciar
# el backend (ni con --reload, que solo vigila los .py).
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://192.168.1.50:5173","http://192.168.1.50:5174","http://192.168.1.50:5175"]
